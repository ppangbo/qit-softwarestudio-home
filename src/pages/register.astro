---
import Layout from '@/layouts/Layout.astro';
import RegisterForm from '@/components/RegisterForm';
---

<Layout title="注册">
  <main class="container mx-auto flex justify-center items-center min-h-[calc(100vh-var(--header-height))] p-4">
    <div class="w-full max-w-md pt-20">
      <h1 class="text-2xl font-bold text-center mb-6">创建账户</h1>
      <RegisterForm client:load /> 
    </div>
  </main>
</Layout>