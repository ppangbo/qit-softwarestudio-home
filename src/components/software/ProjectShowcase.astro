---
import SectionHeader from '@/components/home/SectionHeader.astro';

// Sample project data - replace with actual data later
const projects = [
  {
    title: '项目一：工作室官网',
    description: '使用 Astro 和 Tailwind CSS 构建的现代化工作室静态网站。',
    techStack: ['Astro', 'Tailwind CSS', 'TypeScript'],
    imageUrl: '/assets/placeholder-project.png', // Placeholder image path
    projectUrl: '#'
  },
  {
    title: '项目二：在线协作平台',
    description: '一个基于 Web 的实时协作工具，允许多用户同时编辑文档。',
    techStack: ['React', 'Node.js', 'WebSocket', 'MongoDB'],
    imageUrl: '/assets/placeholder-project.png',
    projectUrl: '#'
  },
  {
    title: '项目三：数据可视化仪表盘',
    description: '为企业提供数据洞察的可视化仪表盘，支持多种图表类型。',
    techStack: ['Vue.js', 'D3.js', 'Express', 'PostgreSQL'],
    imageUrl: '/assets/placeholder-project.png',
    projectUrl: '#'
  }
];
---

<section id="project-showcase" class="py-16 pt-24 md:pt-28">
  <div class="container mx-auto px-4 md:px-6">
    <SectionHeader
      title="项目展示"
      description="我们团队已成功交付多个高质量项目"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <div class="bg-card rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow duration-300">
          <img src={project.imageUrl} alt={project.title} class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">{project.title}</h3>
            <p class="text-muted-foreground text-sm mb-4">{project.description}</p>
            <div class="mb-4">
              <span class="text-sm font-medium text-primary">技术栈:</span>
              <div class="flex flex-wrap gap-2 mt-1">
                {project.techStack.map((tech) => (
                  <span class="text-xs bg-secondary text-secondary-foreground px-2 py-1 rounded">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
            <a
              href={project.projectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center text-sm font-medium text-primary hover:underline"
            >
              查看详情
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Add any specific styles if needed */
</style>